{
	/* Use this project's own TypeScript (node_modules), not VS Code's bundled
	 * version, so editor diagnostics always match `npm run typecheck`/CI. */
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,

	/* JSON schemas */
	"json.schemas": [
		{
			"fileMatch": [
				"**/manifest.json"
			],
			"url": "https://schemas.elgato.com/streamdeck/plugins/manifest.json"
		},
		{
			"fileMatch": [
				"**/layouts/*.json"
			],
			"url": "https://schemas.elgato.com/streamdeck/plugins/layout.json"
		}
	]
}